VITE_YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Twitch "live now" card. Create an app at https://dev.twitch.tv/console/apps
# (OAuth redirect URL can be http://localhost — the client credentials flow
# never uses it). These are read server-side only, by the Netlify function and
# the local dev endpoint, so they are deliberately NOT VITE_ prefixed: anything
# VITE_ prefixed gets bundled into the browser.
TWITCH_CLIENT_ID=your_twitch_app_client_id
TWITCH_CLIENT_SECRET=your_twitch_app_client_secret

# Optional — defaults to slywalker_sound in netlify/lib/twitch.mjs.
# TWITCH_CHANNEL=slywalker_sound
